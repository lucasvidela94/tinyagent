/* Windows resources: the icon, and the version details Explorer shows under
 * Properties > Details (a bare exe with none looks untrustworthy). TS_VERSION_NUM
 * (e.g. 0,8,0,0) comes from the build script, derived from TINYSHELL_VERSION. */
#include <winver.h>

#include "config.h"

#ifndef TS_VERSION_NUM
#define TS_VERSION_NUM 0, 0, 0, 0 /* MSVC builds: the string version below is still exact */
#endif

1 ICON "../../../assets/tinyshell.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION TS_VERSION_NUM
PRODUCTVERSION TS_VERSION_NUM
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040A04B0" /* Spanish (traditional sort), Unicode */
    BEGIN
      VALUE "CompanyName", "TinyShell (Lucas Videla)"
      VALUE "FileDescription", "TinyShell: agente de terminal para PCs viejas"
      VALUE "FileVersion", TINYSHELL_VERSION
      VALUE "InternalName", "tinyshell"
      VALUE "LegalCopyright", "MIT License, Lucas Videla"
      VALUE "OriginalFilename", "tinyshell.exe"
      VALUE "ProductName", "TinyShell"
      VALUE "ProductVersion", TINYSHELL_VERSION
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x040A, 1200
  END
END
